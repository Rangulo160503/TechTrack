# Dejar vacío (recomendado en local): Axios y SignalR usan el mismo origen.
# Vite hace proxy de /api y /hubs (WebSocket) → http://127.0.0.1:5176
# Así no hace falta CORS para el flujo de desarrollo habitual.
#
# Solo configura una URL absoluta si hablas DIRECTO con la API (otro host / HTTPS):
# VITE_API_BASE_URL=https://localhost:7273
# VITE_API_BASE_URL=http://127.0.0.1:5176
VITE_API_BASE_URL=
