{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "UseInMemory": false,
    "ApplyMigrationsOnStartup": false
  },
  "PresenceIngest": {
    "ApiKey": ""
  },
  "LocalSend": {
    "Enabled": false,
    "MulticastAddress": "224.0.0.167",
    "MulticastPort": 53317,
    "HttpPort": 5176,
    "AnnounceIntervalSeconds": 5,
    "Alias": "TechTrack",
    "DeviceModel": "TechTrack API",
    "OfflineAfterSeconds": 90,
    "OfflineCheckIntervalSeconds": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/techtrack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "TechTrack.Api"
    }
  },
  "AllowedHosts": "*"
}
